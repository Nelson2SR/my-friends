
.cu-form-group .title {
		min-width: calc(4em + 15px);
}
. {
		width: 100%;
		height: 200rpx;
		text-align: center;
		line-height: 200rpx;
}
.-V {
		width: 100%;
		height: 150rpx;
		text-align: center;
		line-height: 150rpx;
}
.uni-form-item__title {
		font-size: 16px;
		line-height: 24px;
}
.uni-input-wrapper {

		display: flex;

		padding: 8px 13px;
		flex-direction: row;
		flex-wrap: nowrap;
		background-color: #FFFFFF;
}
.uni-input {
		height: 28px;
		line-height: 28px;
		font-size: 15px;
		padding: 0px;
		flex: 1;
		background-color: #FFFFFF;
}
